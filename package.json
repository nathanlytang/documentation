{
  "name": "documentation",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation for all of Nathan's public repositories",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "markdownlint-cli2 \"docs/**/*.md\" \"README.md\"",
    "lint:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \"README.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
